<?xml version="1.0" encoding="utf-8"?>
<!-- In-flow text button background for the "Patches" entry point. It lives inside
     the top bar / drawer header row, so it is never an overlay. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#408AB4F8">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#26272B" />
            <stroke
                android:width="1dp"
                android:color="#558AB4F8" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</ripple>
