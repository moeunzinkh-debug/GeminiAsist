<?xml version="1.0" encoding="utf-8"?>
<!--
    Chatgpt WebView tag: swap the Gemini launcher for the ChatGPT one.
    src/main/AndroidManifest.xml is NOT modified; the manifest merger applies
    this overlay only to the chatgpt flavor.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <!-- The Gemini activity ships from src/main for the gemini flavor but
             must not be reachable from the ChatGPT app. -->
        <activity
            android:name="com.yourname.gemini.MainActivity"
            tools:node="remove" />

        <activity
            android:name="com.yourname.chatgpt.ChatGptMainActivity"
            android:exported="true"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
